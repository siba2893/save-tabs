#!/usr/bin/env python3
"""
restore-tabs — reopen the tabs captured by `save-tabs`, in order, after a reboot.

Reads ~/.claude/session-backups/RESTORE.json and opens one new iTerm tab per Claude
session, running its `claude --resume <uuid>` command. It NEVER double-resumes: any
session already live (two Claude processes on one transcript corrupt each other) is
skipped with a note.

Windows and tab groups come back too: the first saved window reuses the current iTerm
window, every other saved window gets a new one, and each saved group is recreated
(name, color, collapsed) around its reopened tabs via the `iterm-groups` helper. Files
saved before windows/groups were recorded restore into one window, as before.

Usage:
  restore-tabs              # open a tab per not-already-live session
  restore-tabs --dry-run    # print the plan, open nothing
  restore-tabs --file PATH  # use a specific RESTORE.json
  restore-tabs --prereboot  # force RESTORE-prereboot.json
  (default: the pre-reboot snapshot after a reboot, else RESTORE.json)
"""
import json, os, subprocess, sys, time
from datetime import datetime

OUT_DIR = os.path.expanduser("~/.claude/session-backups")
HERE = os.path.dirname(os.path.realpath(__file__))
CS = os.path.join(HERE, "claude-sessions")
GROUPS_HELPER = os.path.join(HERE, "iterm-groups")
VENV_PY = os.path.join(HERE, ".venv", "bin", "python")  # built by install.sh


def sh(*args):
    try:
        return subprocess.run(args, capture_output=True, text=True).stdout
    except OSError:  # binary missing (e.g. no tmux installed)
        return ""


def load(path):
    """Return (saved_at, tabs, groups)."""
    with open(path) as f:
        data = json.load(f)
    if isinstance(data, dict):
        return data.get("saved_at"), data.get("tabs", []), data.get("groups", [])
    return None, data, []  # legacy: bare list


def live_uuids():
    try:
        data = json.loads(sh(CS, "--json", "--all"))
    except json.JSONDecodeError:
        return set()
    rows = data if isinstance(data, list) else [data]
    return {r.get("sessionId") for r in rows if r.get("sessionId")}


def _esc(s):
    return (s or "").replace("\\", "\\\\").replace('"', '\\"')


def open_tab(cmd, label, where):
    """Create a tab, name it, run cmd. `where` is "new" (a new window), "current" (the
    current window; a new one if iTerm has none) or an iTerm window id.
    Return (window_id, tty, error); on failure window_id/tty are "" and error is osascript's stderr."""
    target = "current window" if where == "current" else f"window id {where}"
    new = "true" if where == "new" else "false"
    script = f'''
tell application "iTerm2"
  if {new} or (count of windows) = 0 then
    set w to (create window with default profile)
    set s to (current session of w)
  else
    set w to {target}
    tell w to set t to (create tab with default profile)
    set s to (current session of t)
  end if
  tell s
    set name to "{_esc(label)}"
    write text "{_esc(cmd)}"
  end tell
  return ((id of w) as text) & " " & (tty of s)
end tell'''
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    win_id, _, tty = r.stdout.strip().partition(" ")
    return win_id, tty, r.stderr.strip()


def iterm_cookie():
    """Python API cookie+key via osascript, the client that already has Automation rights."""
    out = sh("osascript", "-e", 'tell application "iTerm2" to request cookie and key for app named "restore-tabs"')
    cookie, _, key = out.strip().partition(" ")
    return {"ITERM2_COOKIE": cookie, "ITERM2_KEY": key} if cookie and key else None


def apply_groups(specs):
    """Recreate tab groups through the iterm-groups helper. Print what happened; never raise."""
    if not os.path.exists(VENV_PY):
        print("Groups not recreated: helper venv missing (run ./install.sh).")
        return
    env = iterm_cookie()
    if not env:
        print("Groups not recreated: iTerm refused a Python API cookie.")
        return
    try:
        r = subprocess.run([VENV_PY, GROUPS_HELPER, "--apply"], input=json.dumps(specs),
                           capture_output=True, text=True, timeout=30, env={**os.environ, **env})
    except (OSError, subprocess.TimeoutExpired) as e:
        print(f"Groups not recreated: {type(e).__name__}.")
        return
    if r.stdout.strip():
        print(r.stdout.rstrip())
    if r.returncode and r.stderr.strip():
        print(f"Groups helper failed: {r.stderr.strip()[-300:]}")


def rename_tab(tty, label):
    script = f'''
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (tty of s) is "{tty}" then tell s to set name to "{_esc(label)}"
      end repeat
    end repeat
  end repeat
end tell'''
    subprocess.run(["osascript", "-e", script], capture_output=True, text=True)


def open_tab_reissue(tty, cmd):
    """Re-send cmd into the EXISTING tab identified by tty (write fired early the first time)."""
    script = f'''
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (tty of s) is "{tty}" then tell s to write text "{_esc(cmd)}"
      end repeat
    end repeat
  end repeat
end tell'''
    subprocess.run(["osascript", "-e", script], capture_output=True, text=True)


def claude_on_tty(tty):
    """True if a claude process is running on this tty — proof the resume landed."""
    short = tty.replace("/dev/", "")
    out = sh("ps", "-t", short, "-o", "command=")
    return "claude" in out


def boot_time():
    out = sh("sysctl", "-n", "kern.boottime")
    import re
    m = re.search(r"sec\s*=\s*(\d+)", out)
    return int(m.group(1)) if m else 0


def _saved_epoch(p):
    try:
        return datetime.fromisoformat(json.load(open(p)).get("saved_at")).timestamp()
    except Exception:
        return 0


def choose_file():
    """Pick the right RESTORE file. After a reboot you want the last save from BEFORE boot:
    - RESTORE.json still predates boot  -> use it (freshly rebooted, not yet refreshed).
    - else a RESTORE-prereboot.json preserved THIS boot (mtime > boot) -> use it.
    - else RESTORE.json (normal operation)."""
    boot = boot_time()
    main_f = os.path.join(OUT_DIR, "RESTORE.json")
    pre_f = os.path.join(OUT_DIR, "RESTORE-prereboot.json")
    if os.path.exists(main_f) and _saved_epoch(main_f) < boot:
        return main_f, "pre-reboot state (RESTORE.json still predates boot)"
    if os.path.exists(pre_f) and os.path.getmtime(pre_f) > boot:
        return pre_f, "pre-reboot snapshot (RESTORE.json was refreshed after boot)"
    if os.path.exists(main_f):
        return main_f, "current"
    sys.exit("restore-tabs: no RESTORE.json — run `save-tabs` first.")


def main():
    args = sys.argv[1:]
    dry = "--dry-run" in args
    path = why = None
    if "--file" in args:
        path, why = args[args.index("--file") + 1], "explicit --file"
    elif "--prereboot" in args:
        path, why = os.path.join(OUT_DIR, "RESTORE-prereboot.json"), "explicit --prereboot"
    else:
        path, why = choose_file()
    if not os.path.exists(path):
        sys.exit(f"restore-tabs: no {path} — run `save-tabs` first.")
    print(f"Using {os.path.basename(path)} — {why}")

    saved_at, tabs, groups = load(path)
    claude = [t for t in tabs if t.get("kind") == "claude" and t.get("uuid")]
    if saved_at:
        age = ""
        try:
            dt = datetime.fromisoformat(saved_at)
            hrs = (datetime.now(dt.tzinfo) - dt).total_seconds() / 3600
            age = f"  ({hrs:.0f}h ago)" if hrs >= 1 else "  (recent)"
        except ValueError:
            pass
        print(f"Snapshot saved {saved_at}{age} — {len(claude)} Claude tab(s)\n")

    live = live_uuids()
    opened = skipped = 0
    reissued, failed = [], []
    first_win = min((t.get("win", 1) for t in claude), default=1)
    win_ids = {}  # saved window number -> iTerm window id of the window we restore it into
    group_ttys = {}  # (saved window, group name) -> ttys of reopened member tabs
    for t in sorted(claude, key=lambda x: x["pos"]):
        label = t.get("label") or t.get("tab")
        win = t.get("win", 1)
        where = f"[w{win}" + (f" · {t['group']}]" if t.get("group") else "]")
        if t["uuid"] in live:
            print(f"  · {t['pos']:>2} {where} {label}: already live — skipped")
            skipped += 1
            continue
        print(f"  {'→ would open' if dry else '✓ opening'} {t['pos']:>2} {where} {label}: {t['cmd']}")
        if dry:
            continue
        # Resolve "current window" to an id once: it moves to every window we create.
        win_id, tty, err = open_tab(t["cmd"], label,
                                    win_ids.get(win) or ("current" if win == first_win else "new"))
        if not tty:
            print(f"    ✗ could not open a tab: {err or 'osascript returned no tty'}")
            failed.append(t["pos"])
            continue
        win_ids.setdefault(win, win_id)
        if t.get("group"):
            group_ttys.setdefault((win, t["group"]), []).append(tty)
        opened += 1
        # Verify the resume actually landed. `write text` can fire before the shell
        # prompt is ready, leaving the tab at a bare shell — re-issue once if so.
        landed = False
        for _ in range(16):  # up to ~8s
            time.sleep(0.5)
            if claude_on_tty(tty):
                landed = True
                break
        if not landed:
            rename_tab(tty, label)
            open_tab_reissue(tty, t["cmd"])
            reissued.append(t["pos"])
    specs = [{"name": g["name"], "color": g.get("color", ""), "collapsed": g.get("collapsed", False),
              "ttys": group_ttys[(g["win"], g["name"])]}
             for g in groups if group_ttys.get((g["win"], g["name"]))]
    if specs:
        print()
        apply_groups(specs)
    print()
    if dry:
        n_win = len({t.get("win", 1) for t in claude if t["uuid"] not in live})
        print(f"dry-run: {len(claude) - skipped} tab(s) would open in {n_win} window(s), "
              f"{len(groups)} group(s) to recreate, {skipped} already live.")
    else:
        print(f"Opened {opened} tab(s); skipped {skipped} already live.")
        if failed:
            print(f"Failed to open tab(s) {failed} — check iTerm's Automation permission.")
        if reissued:
            print(f"Re-issued the resume on tab(s) {reissued} (first write fired early).")
        elif opened:
            print("All opened tabs confirmed running claude.")
        if failed:
            sys.exit(1)


if __name__ == "__main__":
    main()
