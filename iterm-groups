#!/usr/bin/env python3
"""
iterm-groups — read and recreate iTerm2 tab groups and split-pane sizes through the
iTerm2 Python API.

AppleScript has no tab-group concept and cannot read or size split panes, so save-tabs
and restore-tabs call this helper for those only; creating windows, tabs and panes stays
AppleScript. It runs from the venv install.sh builds
(needs the `iterm2` package). The caller passes ITERM2_COOKIE / ITERM2_KEY, so this
process never asks iTerm for them itself (a new TCC client under launchd could hang on an
unanswerable Automation prompt).

Usage:
  iterm-groups --dump    # print {"groups": [...], "layouts": [...]} (shapes below)
  iterm-groups --apply   # read that same shape on stdin: group the tabs owning those ttys,
                         # then resize each split tab's panes to the saved proportions

  group:  {"name", "color", "collapsed", "ttys": [tty, ...]}
  layout: split tree of a tab with 2+ panes, leaves {"tty", "w", "h"} (cells),
          splitters {"vertical": bool, "children": [...]}
"""
import json, sys

import iterm2

failures = 0


async def tty_index(app):
    """tty -> (window, tab) for every session, in window/tab order."""
    idx = {}
    for w in app.terminal_windows:
        for t in w.tabs:
            for s in t.sessions:
                tty = await s.async_get_variable("tty")
                if tty:
                    idx[tty] = (w, t)
    return idx


async def tree_of(node):
    if isinstance(node, iterm2.Splitter):
        return {"vertical": node.vertical, "children": [await tree_of(c) for c in node.children]}
    size = node.grid_size
    return {"tty": await node.async_get_variable("tty"), "w": size.width, "h": size.height}


def extent(tree):
    """(width, height) in cells of a tree: siblings add up along the split axis."""
    if "tty" in tree:
        return tree["w"], tree["h"]
    sizes = [extent(c) for c in tree["children"]]
    if tree["vertical"]:  # vertical dividers: panes side by side
        return sum(w for w, _ in sizes), max(h for _, h in sizes)
    return max(w for w, _ in sizes), sum(h for _, h in sizes)


async def dump(conn):
    app = await iterm2.async_get_app(conn)
    groups, layouts = {}, []
    for tty, (_, t) in (await tty_index(app)).items():
        g = t.tab_group
        if g:
            e = groups.setdefault(g.group_id, {"name": g.name, "color": g.color.hex if g.color else "",
                                               "collapsed": g.collapsed, "ttys": []})
            e["ttys"].append(tty)
    for w in app.terminal_windows:
        for t in w.tabs:
            if len(t.sessions) > 1:
                layouts.append(await tree_of(t.root))
    print(json.dumps({"groups": list(groups.values()), "layouts": layouts}))


async def resize(app, saved):
    """Scale the saved pane sizes to the restored tab's current extent and apply them."""
    leaves = []

    def collect(node):
        if "tty" in node:
            leaves.append(node)
        else:
            for c in node["children"]:
                collect(c)
    collect(saved)
    sessions = {}
    tab = None
    for w in app.terminal_windows:
        for t in w.tabs:
            for s in t.sessions:
                tty = await s.async_get_variable("tty")
                if tty in (l["tty"] for l in leaves):
                    sessions[tty], tab = s, t
    if tab is None or len(sessions) != len(leaves):
        raise RuntimeError("not every pane of the tab is open")
    now_w, now_h = extent(await tree_of(tab.root))
    was_w, was_h = extent(saved)
    for l in leaves:
        sessions[l["tty"]].preferred_size = iterm2.util.Size(max(1, round(l["w"] * now_w / was_w)),
                                                             max(1, round(l["h"] * now_h / was_h)))
    await tab.async_update_layout()
    return len(leaves)


async def apply(conn):
    global failures
    spec = json.load(sys.stdin)
    app = await iterm2.async_get_app(conn)
    idx = await tty_index(app)
    for layout in spec.get("layouts", []):
        try:
            print(f"  ✓ split panes resized: {await resize(app, layout)} pane(s)")
        except Exception as e:
            failures += 1
            print(f"  ✗ split pane sizes: {e}")
    for g in spec.get("groups", []):
        hits = [idx[tty] for tty in g["ttys"] if tty in idx]
        if not hits:
            print(f"  · group {g['name']}: none of its tabs are open — skipped")
            continue
        window = hits[0][0]
        tabs = []
        for w, t in hits:  # a group lives in one window; dedupe tabs holding several panes
            if w.window_id == window.window_id and t.tab_id not in (x.tab_id for x in tabs):
                tabs.append(t)
        try:
            color = iterm2.Color.from_hex(g["color"]) if g.get("color") else None
            group = await window.async_create_tab_group(g["name"], tabs, color=color)
            if g.get("collapsed"):
                await group.async_set_collapsed(True)
            print(f"  ✓ group {g['name']}: {len(tabs)} tab(s)")
        except Exception as e:  # RPCException, AppVersionTooOld, ...
            failures += 1
            print(f"  ✗ group {g['name']}: {e}")


def main():
    if "--dump" in sys.argv:
        iterm2.run_until_complete(dump)
    elif "--apply" in sys.argv:
        iterm2.run_until_complete(apply)
        sys.exit(1 if failures else 0)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
