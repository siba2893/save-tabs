<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.siba.save-tabs</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__INSTALL_DIR__/save-tabs</string>
        <string>--auto</string>
    </array>

    <!-- Every 15 minutes, and once immediately on load, so an UNPLANNED reboot still
         has a recent RESTORE.md. --auto writes only ~/.claude/session-backups/RESTORE.md
         (no dated archive), and never clobbers a good file with an empty run. -->
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>__INSTALL_DIR__</string>

    <!-- claude lives in ~/.local/bin; osascript needs a login-shell PATH to reach iTerm. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__INSTALL_DIR__/launchd-save-tabs.out</string>
    <key>StandardErrorPath</key>
    <string>__INSTALL_DIR__/launchd-save-tabs.err</string>
</dict>
</plist>
